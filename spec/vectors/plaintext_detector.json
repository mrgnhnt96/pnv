  "files": [
    {
      "name": "only string scalars are checked",
      "note": "an int, a bool, a null and a list are never flagged, whatever the key",
      "yaml": "pin: 12345678\npassword: 12345678\nquoted-password: \"12345678\"\nenabled-token: true\napi-key:\nlist-token:\n  - somethingreal123\n",
      "flagged": [
        "quoted-password"
      ]
    },
    {
      "name": "secrets are skipped",
      "yaml": "api-key: SECRET;v1:ikceywABAgMEBQYHCAkKCyLDfmHplmR3TDvBmf48BQQ9Ry9u/Zx9DFyk6Ao=\n",
      "flagged": []
    },
    {
      "name": "nested paths and the marker comment",
      "yaml": "db:\n  password: hunter2hunter2\n  host: localhost\ndemo-token: sk-live-not-real-at-all # plaintext, used in the public demo\nother-token: sk-live-not-real-at-all # int\n",
      "flagged": [
        "db.password",
        "other-token"
      ]
    },
    {
      "name": "the marker on another line does not count",
      "yaml": "# plaintext\napi-key: somethingreal123\n",
      "flagged": [
        "api-key"
      ]
    },
    {
      "name": "every document of a multi-document file is checked",
      "note": "a file of several --- documents is valid YAML; each document's leaves are checked, so the second document's password is found",
      "yaml": "name: default\ntoken: abc # plaintext\n---\nname: second\ndb:\n  password: hunter2hunter2\n---\n- a list document has no leaves\n",
      "flagged": [
        "db.password"
      ]
    }
  ]
